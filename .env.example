# Copy to .env and fill in as needed. The offline demos need no keys.

# For the LLM extractor (--mode llm / auto):
OPENAI_API_KEY=

# For scanned / image documents via AWS Textract (textract_demo.py --image ...):
# Free tier covers 1,000 AnalyzeExpense pages/month.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
